# Gitignore de raiz do monorepo -- cobre qualquer app novo mesmo antes de ele
# ter .gitignore proprio. Nao remove do rastreamento o que ja foi commitado
# antes disso existir (ver docs/ sobre apps/ybytu-app/node_modules).

node_modules/
dist/
dist-ssr/
build/
.expo/
.next/
.turbo/
.vercel/
coverage/

.env
.env.local
.env.*.local

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

.DS_Store
Thumbs.db
*.local

.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Artefatos locais da migracao de midia pro R2 (2026-09) -- os JPGs ja
# estao no bucket, versionar copia local so polui o repo. Processo de
# regeneracao documentado em docs/MIGRACAO_VIDEOS_CLOUDFLARE_20260904.md
# ("Geracao de thumbnail -- frame a 40% da duracao"), nao depende de nada
# que so exista nestes arquivos.
r2_thumbnails/
r2_videos.txt

# Saida do graphify (docs/GRAPHIFY.md) -- graph.json/graph.html/GRAPH_REPORT.md sao
# versionados (sanitizados via scripts/sanitize-graphify.sh antes de cada commit);
# o resto e cache/estado local que muda a cada regeneracao e so gera ruido no diff.
graphify-out/cache/
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/.graphify_python
